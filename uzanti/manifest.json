{
  "manifest_version": 3,
  "name": "Meet",
  "description": "Meet for Google Meet, Teams and Zoom on the web: tells the local Meet app when you are in a call, who is there and who is speaking (from captions); side panel with prep notes, live suggestions, notes and summary. Talks only to Meet on this Mac.",
  "version": "3.23",
  "icons": {
    "16": "ikonlar/16.png",
    "32": "ikonlar/32.png",
    "48": "ikonlar/48.png",
    "128": "ikonlar/128.png"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "sidePanel",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Meet · yan paneli aç",
    "default_icon": {
      "16": "ikonlar/16.png",
      "32": "ikonlar/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
